---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostTimeline from '../components/PostTimeline.astro';
import { groupPostEntries, normalizePostEntries } from '../data/posts';

const globModules: Record<string, any> = import.meta.glob('../../content/posts/*.md', { eager: true });
const entries = normalizePostEntries(Object.values(globModules).map((file: any) => file.frontmatter));
const groups = groupPostEntries(entries);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="十四日纪事" description="和音滇韵｜十四日音乐支教田野纪事">
  <section class="diary-hero">
    <div class="container">
      <p class="eyebrow">FIELD JOURNAL / 2026</p>
      <div class="diary-title-row"><span class="hero-number">14</span><div><h1>十四日<br />纪事</h1><p>2026.07.26—08.08</p></div></div>
      <p class="diary-lead">从抵达澜沧的第一天到告别演出，每一个瞬间都值得记住。我们用日期、地点和文字，把这段共同走过的时间留在这里。</p>
    </div>
  </section>

  <section class="diary-body section">
    <div class="container">
      {entries.length === 0 ? (
        <div class="empty-diary"><p>暂无可读纪事。</p><a class="text-link" href={base}>返回首页</a></div>
      ) : (
        <>
          {groups.prologue.length > 0 && <div class="phase-label"><span>序章</span><small>出发之前，先把队伍聚在一起。</small></div>}
          <PostTimeline entries={groups.prologue} />
          <div class="phase-label phase-label--journey"><span>十四日主时间轴</span><small>2026.07.26—08.08</small></div>
          <PostTimeline entries={groups.journey} />
          <section class="diary-after"><p class="section-kicker">AFTER / 14</p><h2>十四天之后，我们留下些什么</h2><p>课程会结束，歌声不会只停留在教室。我们把共同完成过的旋律、彼此记住的名字和那些没有被安排的片刻，交给影像与文字继续保存。</p><a class="text-link" href={base + 'moments'}>进入影像档案</a></section>
        </>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .diary-hero { padding: 130px 0 92px; border-bottom: 1px solid var(--line); }
  .diary-title-row { display: flex; align-items: flex-end; gap: clamp(22px, 5vw, 80px); margin-top: 26px; }
  .hero-number { color: var(--lacquer); font-family: var(--font-mono); font-size: clamp(9rem, 23vw, 22rem); font-weight: 300; letter-spacing: -0.12em; line-height: 0.68; }
  .diary-title-row h1 { font-size: clamp(3.2rem, 8vw, 7rem); letter-spacing: -0.08em; line-height: 0.96; }
  .diary-title-row p { margin-top: 20px; color: var(--lacquer); font-family: var(--font-mono); font-size: 0.82rem; }
  .diary-lead { max-width: 590px; margin: 52px 0 0 auto; font-family: var(--font-heading); font-size: clamp(1.2rem, 2.2vw, 1.7rem); line-height: 1.8; }
  .diary-body { padding-top: 80px; }
  .phase-label { display: flex; align-items: baseline; gap: 20px; margin: 0 0 28px 198px; padding-top: 20px; border-top: 1px solid var(--lacquer); }
  .phase-label span { color: var(--lacquer); font-family: var(--font-heading); font-size: 1.55rem; }
  .phase-label small { color: var(--mist); }
  .phase-label--journey { margin-top: 44px; }
  .diary-after { max-width: 720px; margin: 54px 0 0 198px; padding: 72px 0 10px; border-top: 1px solid var(--line); }
  .diary-after h2 { margin: 14px 0 20px; font-size: clamp(2rem, 4vw, 3.3rem); }
  .diary-after > p:not(.section-kicker) { color: rgba(33, 27, 24, 0.72); line-height: 2; }
  .diary-after .text-link { margin-top: 22px; }
  .empty-diary { padding: 100px 0; text-align: center; }
  @media (max-width: 800px) { .diary-hero { padding: 120px 0 70px; } .diary-title-row { gap: 22px; } .hero-number { font-size: clamp(7rem, 28vw, 12rem); } .diary-lead { margin: 48px 0 0; } .phase-label, .diary-after { margin-left: 0; } }
  @media (max-width: 520px) { .diary-title-row { align-items: center; } .hero-number { font-size: 7rem; } .diary-title-row h1 { font-size: 3.3rem; } .diary-lead { font-size: 1.1rem; } .phase-label { display: grid; gap: 4px; } }
</style>
