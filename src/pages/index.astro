---
import BaseLayout from '../layouts/BaseLayout.astro';
import PersonDetails from '../components/PersonDetails.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { getResponsiveImage } from '../lib/images';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const base = import.meta.env.BASE_URL;
const chapterOneImage = 'images/chapters/chapter-01.jpg';
const hasChapterOneImage = existsSync(join(process.cwd(), 'assets', 'images-original', chapterOneImage.replace(/^images[\\/]/, '')));
const globModules: Record<string, any> = import.meta.glob('../../content/posts/*.md', { eager: true });
const posts = Object.values(globModules)
  .map((file: any) => ({
    date: String(file.frontmatter.date),
    title: String(file.frontmatter.title || ''),
    cover: String(file.frontmatter.cover || ''),
    excerpt: String(file.frontmatter.excerpt || ''),
    url: String(file.frontmatter.url || ''),
  }))
  .sort((a, b) => a.date.localeCompare(b.date));

const highlights = [
  { key: '7.26', label: '初见', title: '实践日志｜第0天 落地澜沧', image: 'images/posts/7.26.jpg', text: posts.find((p) => p.date === '2026-07-26')?.excerpt || '', url: posts.find((p) => p.date === '2026-07-26')?.url || '#' },
  { key: '7.31', label: '深入', title: '夏日澜沧｜和小朋友们的温暖瞬间', image: 'images/posts/7.30.jpg', text: posts.find((p) => p.date === '2026-07-30')?.excerpt || '', url: posts.find((p) => p.date === '2026-07-30')?.url || '#' },
  { key: '8.08', label: '回望', title: '民族歌曲专题｜旋律载文脉，歌声筑团结', image: 'images/posts/8.8.jpg', text: posts.find((p) => p.date === '2026-08-08')?.excerpt || '', url: posts.find((p) => p.date === '2026-08-08')?.url || '#' },
];

const chapters = [
  { number: '01', title: '抵达｜跨越山海，来到澜沧', text: '从北京出发，沿着山路走进澜沧。准备、抵达、第一次走进校园，陌生的地方在一声问候和一次并肩行走里慢慢有了名字。', image: hasChapterOneImage ? chapterOneImage : null, alt: '第一幕：跨越山海，抵达澜沧' },
  { number: '02', title: '共唱｜课堂里的节拍与回应', text: '简谱、发声、合唱和民族音乐专题，组成了课堂里的节拍。我们带来一段旋律，也在孩子们的回应里重新学会倾听。', image: 'images/moments/moment-17.jpg', alt: '课堂中孩子与实践成员共同完成音乐活动' },
  { number: '03', title: '回响｜告别之后留下什么', text: '十四天结束时，留下的不只是照片和文字。那些一起唱过的歌、写在黑板上的字和互相记住的名字，仍在山路之外继续回响。', image: 'images/moments/moment-23.jpg', alt: '实践成员在澜沧街头留下旅程中的合影' },
];

const leaders = [
  { name: '孙雅楠', role: '指导成员 · 指导老师', image: 'images/portraits/sunyanan.jpg', summary: '负责实践指导与团队支持，陪伴成员把准备工作落到每一次真实相遇里。', bio: '外国语学院研工组长、就业指导教师，外研24、本科23级辅导员。曾获评北京科技大学暑期社会实践优秀指导教师、社会实践先进工作者。' },
  { name: '郭辉', role: '指导成员 · 指导学姐', image: 'images/portraits/guohui.jpg', summary: '以过往实践经验支持队伍，在支教、调研与日常协作中持续同行。', bio: '大数据241班。曾担任2025年酉良实践团团长，今年以指导学姐身份加入，全程协助小队开展支教与调研工作。' },
];

const students = [
  { name: '雷梓宸', role: '队长 · 小提琴', image: 'images/portraits/leizichen.jpg', summary: '把对音乐的热爱带进课堂，也负责让团队的节拍始终向前。', bio: '性格热情开朗，擅长小提琴，也是学校合唱团与管乐团成员。' },
  { name: '张尧', role: '副队长 · 外联策划', image: 'images/portraits/zhangyao.jpg', summary: '连接队伍与外部协作，让每一次课程和活动都有清晰的准备。', bio: '材料2507，擅长钢琴和吉他，现任北科合唱团钢琴伴奏和管乐团打击乐声部成员。' },
  { name: '杜雅芬', role: '教学宣传', image: 'images/portraits/duyafen.jpg', summary: '用温柔的陪伴靠近孩子，也把课堂故事整理成可以被看见的记录。', bio: '英语252班，有支教经历，擅长和小朋友相处，负责教学与宣传工作。' },
  { name: '李昭琰', role: '摄影记录', image: 'images/portraits/lizhaoyan.jpg', summary: '安静观察课堂和日常，用镜头保存那些不经意发生的瞬间。', bio: '机械2511，愿意和小朋友们交流，也细心记录团队里的每一件小事。' },
  { name: '邓剑', role: '教学组', image: 'images/portraits/dengjian.jpg', summary: '成长于云南，以熟悉家乡的情感把音乐和在地文化带进交流。', bio: '矿业2503班，热爱音乐，成长于云南，希望用音乐搭建沟通桥梁。' },
  { name: '巴宗胜', role: '教学组', image: 'images/portraits/bashengsheng.jpg', summary: '善于倾听和沟通，在耐心的协作里把课堂变成共同参与的空间。', bio: '机械2504班，喜爱音乐，重视团队协作，希望在实践中传递温暖。' },
  { name: '曾嘉', role: '教学组', image: 'images/portraits/zengjia.jpg', summary: '带着开朗随和的性格加入队伍，在两周相处里认真完成每一件事。', bio: '机械工程学院，喜欢踢足球和弹琴，很有幸加入队伍并参与这段旅程。' },
];
---

<BaseLayout title="首页" description="和音滇韵｜十四日音乐支教田野纪事" ogImage="images/team-photo.jpg">
  <section class="home-hero">
    <div class="hero-copy">
      <p class="eyebrow">BEIJING · LANCANG · 2026</p>
      <h1>和音<br /><em>滇韵</em></h1>
      <p class="hero-subtitle">十四日音乐支教田野纪事</p>
      <p class="hero-sentence">以音乐为桥，连接京滇山海。</p>
      <div class="hero-meta"><span>云南 · 澜沧</span><span>2026.07.26—08.08</span><span>14 DAYS</span></div>
      <svg class="voice-line" viewBox="0 0 420 70" role="img" aria-label="声纹线条"><path d="M2 36 C44 36 48 16 76 16 C102 16 108 55 134 55 C164 55 171 27 201 27 C230 27 238 45 264 45 C292 45 303 18 330 18 C357 18 365 36 418 36" /></svg>
    </div>
    <figure class="hero-image">
      <ResponsiveImage image={getResponsiveImage('images/team-photo.jpg')} alt="和音滇韵民族团结实践团队合影" sizes="(max-width: 800px) 100vw, 58vw" loading="eager" fetchpriority="high" />
      <figcaption><span>团队合影 / 01</span><span>北京科技大学</span></figcaption>
    </figure>
  </section>

  <section class="manifesto" aria-label="项目宣言">
    <p>十四个日夜，我们没有试图替谁改变什么。<br />我们只是带着音乐来到这里，然后一起唱了一段。</p>
  </section>

  <section class="section overview-section">
    <div class="container">
      <p class="section-kicker">ARCHIVE / 01</p>
      <h2 class="section-title">实践概况</h2>
      <div class="archive-grid">
        <div><span>地点</span><strong>云南省普洱市澜沧拉祜族自治县</strong></div>
        <div><span>时间</span><strong>2026.07.26—08.08 / 14 DAYS</strong></div>
        <div><span>团队</span><strong>7 名学生成员 + 2 名指导成员</strong></div>
        <div><span>内容</span><strong>音乐教学、合唱排练、民族文化交流与实践记录</strong></div>
      </div>
    </div>
  </section>

  <section class="section chapters-section">
    <div class="container">
      <p class="section-kicker">FIELD NOTES / 02</p>
      <h2 class="section-title">三幕相遇</h2>
      <div class="chapter-list">
        {chapters.map((chapter, index) => (
          <article class:list={['chapter', index % 2 === 1 && 'chapter--reverse']}>
            <div class="chapter-index">{chapter.number}</div>
            {chapter.image ? (
              <figure><ResponsiveImage image={getResponsiveImage(chapter.image)} alt={chapter.alt} sizes="(max-width: 800px) 100vw, 55vw" /></figure>
            ) : (
              <figure class="chapter-media--empty" aria-hidden="true"></figure>
            )}
            <div class="chapter-copy"><p class="date-label">CHAPTER {chapter.number}</p><h3>{chapter.title}</h3><p>{chapter.text}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section diary-preview">
    <div class="container">
      <div class="section-heading-row"><div><p class="section-kicker">DIARY / 03</p><h2 class="section-title">精选纪事</h2></div><a class="text-link" href={base + 'diary'}>查看完整十四日纪事</a></div>
      <div class="highlight-grid">
        {highlights.map((item, index) => (
          <article class:list={['highlight', index === 0 && 'highlight--large']}>
            <a href={item.url} target="_blank" rel="noopener noreferrer">
              <ResponsiveImage image={getResponsiveImage(item.image)} alt={item.title} sizes="(max-width: 800px) 100vw, 34vw" loading={index === 0 ? 'eager' : 'lazy'} />
              <div class="highlight-copy"><p class="date-label">{item.key} · {item.label}</p><h3>{item.title}</h3><p>{item.text}</p><span class="text-link">阅读原文</span></div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section companions-section">
    <div class="container">
      <p class="section-kicker">PEOPLE / 04</p><h2 class="section-title">同行者</h2>
      <div class="people-group"><div class="people-heading"><span>01</span><h3>指导成员 <small>2 人</small></h3></div><div class="people-grid">{leaders.map((person) => <PersonDetails person={person} />)}</div></div>
      <div class="people-group"><div class="people-heading"><span>02</span><h3>学生成员 <small>7 人</small></h3></div><div class="people-grid">{students.map((person) => <PersonDetails person={person} />)}</div></div>
    </div>
  </section>

  <section class="archive-entry">
    <div class="archive-entry-inner">
      <div><p class="section-kicker">ARCHIVE / 05</p><h2>进入十四日的回声</h2><p>35 段影像，按日期、地点与故事重新相遇。</p><a class="text-link" href={base + 'moments'}>进入影像档案</a></div>
      <div class="archive-photos" aria-hidden="true"><ResponsiveImage image={getResponsiveImage('images/moments/moment-20.jpg')} alt="" sizes="20vw" /><ResponsiveImage image={getResponsiveImage('images/moments/moment-06.jpg')} alt="" sizes="20vw" /><ResponsiveImage image={getResponsiveImage('images/moments/moment-21.jpg')} alt="" sizes="20vw" /></div>
    </div>
  </section>

  <section class="closing"><p>和音滇韵，山海有声。</p></section>
</BaseLayout>

<style>
  .home-hero { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: end; gap: clamp(32px, 7vw, 108px); width: min(100% - 96px, var(--max-width)); min-height: calc(100vh - var(--nav-height)); margin: 0 auto; padding: 100px 0 72px; }
  .hero-copy { position: relative; padding-bottom: 22px; }
  .hero-copy h1 { margin: 18px 0 20px; font-size: clamp(4.6rem, 10vw, 9.2rem); font-weight: 600; letter-spacing: -0.08em; line-height: 0.9; }
  .hero-copy h1 em { color: var(--lacquer); font-style: normal; }
  .hero-subtitle { font-family: var(--font-heading); font-size: clamp(1.2rem, 2vw, 1.7rem); }
  .hero-sentence { margin-top: 20px; color: var(--lacquer); font-size: 0.95rem; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 44px; color: var(--mist); font-family: var(--font-mono); font-size: 0.72rem; }
  .hero-meta span + span::before { content: " / "; margin-right: 16px; color: var(--bamboo); }
  .voice-line { width: min(100%, 420px); height: auto; margin-top: 32px; overflow: visible; }
  .voice-line path { fill: none; stroke: var(--lacquer); stroke-width: 1.4; stroke-dasharray: 520; stroke-dashoffset: 520; animation: draw-line 1.1s 0.4s ease-out forwards; }
  .hero-image { position: relative; margin: 0; }
  .hero-image img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .hero-image figcaption { display: flex; justify-content: space-between; gap: 16px; margin-top: 10px; color: var(--mist); font-family: var(--font-mono); font-size: 0.68rem; }
  .manifesto { display: grid; place-items: center; min-height: 55vh; padding: 100px 20px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); text-align: center; }
  .manifesto p { font-family: var(--font-heading); font-size: clamp(1.5rem, 3vw, 2.6rem); line-height: 1.75; }
  .archive-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); }
  .archive-grid > div { min-height: 146px; padding: 22px 22px 0 0; border-right: 1px solid var(--line); }
  .archive-grid > div:not(:first-child) { padding-left: 22px; }
  .archive-grid > div:last-child { border-right: 0; }
  .archive-grid span, .people-heading span { display: block; margin-bottom: 22px; color: var(--lacquer); font-family: var(--font-mono); font-size: 0.68rem; }
  .archive-grid strong { display: block; font-weight: 500; line-height: 1.65; }
  .chapter-list { border-top: 1px solid var(--line); }
  .chapter { display: grid; grid-template-columns: 72px minmax(0, 6fr) minmax(260px, 5fr); gap: 28px; align-items: center; padding: 48px 0; border-bottom: 1px solid var(--line); }
  .chapter--reverse { grid-template-columns: 72px minmax(260px, 5fr) minmax(0, 6fr); }
  .chapter--reverse figure { grid-column: 3; grid-row: 1; }
  .chapter--reverse .chapter-copy { grid-column: 2; grid-row: 1; }
  .chapter-index { align-self: start; color: var(--lacquer); font-family: var(--font-mono); font-size: 0.8rem; }
  .chapter figure { margin: 0; aspect-ratio: 4 / 3; }
  .chapter img { width: 100%; height: 100%; object-fit: cover; }
  .chapter-media--empty { border: 1px solid var(--line); background: rgba(199, 186, 162, 0.16); }
  .chapter-copy { max-width: 430px; }
  .chapter-copy h3 { margin: 14px 0 18px; font-size: clamp(1.7rem, 3vw, 2.7rem); }
  .chapter-copy > p:last-child { color: rgba(33, 27, 24, 0.72); line-height: 2; }
  .section-heading-row { display: flex; align-items: end; justify-content: space-between; gap: 24px; }
  .highlight-grid { display: grid; grid-template-columns: 1.5fr 1fr 1fr; gap: 24px; }
  .highlight { border-top: 1px solid var(--line); }
  .highlight a { color: inherit; }
  .highlight img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .highlight--large img { aspect-ratio: 5 / 4; }
  .highlight-copy { padding: 20px 0; }
  .highlight-copy h3 { margin: 10px 0; font-size: 1.3rem; }
  .highlight-copy > p:not(.date-label) { color: rgba(33, 27, 24, 0.68); font-size: 0.92rem; line-height: 1.85; }
  .highlight-copy .text-link { margin-top: 14px; font-size: 0.86rem; }
  .people-group + .people-group { margin-top: 76px; }
  .people-heading { display: flex; align-items: baseline; gap: 18px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
  .people-heading span { margin: 0; }
  .people-heading h3 { font-size: 1.8rem; }
  .people-heading small { margin-left: 8px; color: var(--mist); font-family: var(--font-mono); font-size: 0.68rem; font-weight: 400; }
  .people-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .person { border-bottom: 1px solid var(--line); }
  .person summary { position: relative; display: block; list-style: none; cursor: pointer; }
  .person summary::-webkit-details-marker { display: none; }
  .person summary img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; filter: saturate(0.82); }
  .person-text { position: relative; display: block; padding: 14px 28px 16px 0; }
  .person-text strong, .person-text span, .person-text small { display: block; }
  .person-text strong { font-family: var(--font-heading); font-size: 1.2rem; }
  .person-text span { color: var(--lacquer); font-size: 0.76rem; }
  .person-text small { margin-top: 8px; color: rgba(33, 27, 24, 0.68); font-size: 0.82rem; line-height: 1.65; }
  .person-text i { position: absolute; right: 0; top: 16px; color: var(--lacquer); font: normal 1.3rem var(--font-mono); }
  .person[open] .person-text i { transform: rotate(45deg); }
  .person > p { padding: 0 0 18px; color: rgba(33, 27, 24, 0.76); font-size: 0.88rem; line-height: 1.8; }
  .archive-entry { padding: 120px max(20px, calc((100vw - var(--max-width)) / 2)); background: var(--night); color: var(--paper-white); }
  .archive-entry-inner { display: grid; grid-template-columns: 1fr 1.1fr; gap: 80px; align-items: center; max-width: var(--max-width); margin: 0 auto; }
  .archive-entry h2 { margin: 14px 0 14px; color: var(--paper-white); font-size: clamp(2.5rem, 5vw, 5.3rem); letter-spacing: -0.06em; }
  .archive-entry p:not(.section-kicker) { color: rgba(251, 248, 241, 0.68); }
  .archive-entry .text-link { margin-top: 34px; color: var(--paper-white); }
  .archive-entry .section-kicker { color: var(--bamboo); }
  .archive-photos { position: relative; min-height: 390px; }
  .archive-photos :global(img) { position: absolute; width: 44%; aspect-ratio: 3 / 4; object-fit: cover; border: 5px solid var(--night); }
  .archive-photos :global(img:nth-child(1)) { top: 28px; left: 0; transform: rotate(-5deg); }
  .archive-photos :global(img:nth-child(2)) { top: 0; right: 24%; transform: rotate(4deg); }
  .archive-photos :global(img:nth-child(3)) { right: 0; bottom: 0; transform: rotate(-2deg); }
  .closing { padding: 90px 20px 0; text-align: center; }
  .closing p { font-family: var(--font-heading); font-size: clamp(1.7rem, 3vw, 2.8rem); }
  @keyframes draw-line { to { stroke-dashoffset: 0; } }
  @media (max-width: 900px) { .home-hero { width: min(100% - 64px, var(--max-width)); grid-template-columns: 1fr 1.2fr; gap: 32px; } .archive-grid { grid-template-columns: repeat(2, 1fr); } .archive-grid > div:nth-child(2) { border-right: 0; } .archive-grid > div:nth-child(-n+2) { border-bottom: 1px solid var(--line); } .chapter { grid-template-columns: 48px minmax(0, 1fr); } .chapter figure, .chapter--reverse figure { grid-column: 2; grid-row: 1; } .chapter-copy, .chapter--reverse .chapter-copy { grid-column: 2; grid-row: 2; max-width: none; } .people-grid { grid-template-columns: repeat(3, 1fr); } .archive-entry-inner { gap: 36px; } }
  @media (max-width: 600px) { .home-hero { display: flex; flex-direction: column; align-items: stretch; width: calc(100% - 40px); min-height: auto; padding: 110px 0 60px; } .hero-copy { padding: 0; } .hero-copy h1 { font-size: clamp(4rem, 19vw, 6rem); } .hero-meta { margin-top: 30px; gap: 8px; } .hero-meta span + span::before { margin-right: 8px; } .voice-line { margin-top: 24px; } .hero-image img { aspect-ratio: 4 / 3; } .manifesto { min-height: 42vh; padding: 72px 20px; text-align: left; } .manifesto p { font-size: 1.45rem; } .archive-grid { grid-template-columns: 1fr; } .archive-grid > div, .archive-grid > div:not(:first-child) { min-height: auto; padding: 18px 0; border-right: 0; border-bottom: 1px solid var(--line); } .archive-grid > div:last-child { border-bottom: 0; } .chapter { grid-template-columns: 36px 1fr; gap: 12px; padding: 34px 0; } .chapter-copy h3 { font-size: 1.7rem; } .section-heading-row { display: block; } .section-heading-row .text-link { margin-top: 4px; } .highlight-grid { grid-template-columns: 1fr; gap: 30px; } .highlight--large img, .highlight img { aspect-ratio: 4 / 3; } .people-grid { grid-template-columns: repeat(2, 1fr); gap: 16px; } .people-group + .people-group { margin-top: 56px; } .people-heading h3 { font-size: 1.5rem; } .person-text small { font-size: 0.76rem; } .archive-entry { padding: 82px 20px; } .archive-entry-inner { grid-template-columns: 1fr; } .archive-photos { min-height: 270px; } .closing { padding-top: 68px; } }
</style>
