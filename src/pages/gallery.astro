---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryTimeline from '../components/GalleryTimeline.astro';
import Lightbox from '../components/Lightbox.astro';

// Gallery data — add media entries here
const galleryGroups: any[] = [];
---

<BaseLayout title="精彩瞬间" description="和音滇韵实践团活动照片与视频记录">
  <section class="section gallery-page">
    <div class="container">
      <h2 class="section-title">精彩瞬间</h2>
      <p class="gallery-intro">按下快门的每一刻，都是澜沧江畔最温暖的记忆。</p>
      {galleryGroups.length === 0 ? (
        <div class="gallery-empty">
          <p>暂无图片视频记录，敬请期待。</p>
        </div>
      ) : (
        <GalleryTimeline groups={galleryGroups} />
      )}
    </div>
  </section>

  <Lightbox />
</BaseLayout>

<style>
  .gallery-page {
    padding-top: 48px;
  }

  .gallery-intro {
    text-align: center;
    color: var(--color-text-light);
    font-size: 1rem;
    margin-bottom: 56px;
    margin-top: -24px;
  }

  .gallery-empty {
    text-align: center;
    padding: 80px 0;
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }
</style>
