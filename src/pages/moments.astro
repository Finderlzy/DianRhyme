---
import BaseLayout from '../layouts/BaseLayout.astro';
import { moments } from '../data/moments';
---

<BaseLayout title="精彩瞬间" description="探索我们的滇行记忆">
  <div id="universe-canvas" class="universe-canvas"></div>
  <div class="atmosphere" aria-hidden="true"></div>

  {moments.length === 0 ? (
    <div class="empty-state">
      <p class="empty-state-title">这里还没有照片</p>
      <p class="empty-state-desc">精彩瞬间正在整理中，先回首页看看吧。</p>
      <a class="empty-state-link" href={import.meta.env.BASE_URL}>返回首页</a>
    </div>
  ) : (
    <>
      <div id="guide" class="guide">探索我们的滇行记忆</div>

      <figure id="caption" class="caption is-hidden" aria-live="polite">
        <div class="caption-rule" aria-hidden="true"></div>
        <figcaption class="caption-title" id="caption-title"></figcaption>
        <p class="caption-meta" id="caption-meta"></p>
        <p class="caption-desc" id="caption-desc"></p>
      </figure>

      <p id="hint" class="hint is-hidden">拖动旋转 · 滚轮缩放 · 点击查看</p>
      <button id="back-btn" class="back-btn is-hidden" type="button">返回探索</button>
      <p id="loading" class="loading is-hidden" aria-hidden="true">正在点亮记忆…</p>
    </>
  )}
</BaseLayout>

<script>
  const container = document.getElementById('universe-canvas');
  const guide = document.getElementById('guide');
  const caption = document.getElementById('caption');
  const hint = document.getElementById('hint');
  const backBtn = document.getElementById('back-btn');
  const loading = document.getElementById('loading');

  let dispose = () => {};
  document.addEventListener('astro:before-swap', () => dispose(), { once: true });

  (async () => {
    if (!container) return;
    const { initUniverse } = await import('../three/main');
    if (!container.isConnected) return; // 加载期间已切走
    const handle = initUniverse(container, { guideElement: guide, captionElement: caption, hintElement: hint, backButton: backBtn, loadingElement: loading });
    dispose = handle.dispose;
  })();
</script>

<style is:global>
  #universe-canvas {
    position: fixed;
    inset: 0;
    z-index: 0;
  }

  /* 暗色页上噪点遮罩几乎不可见,隐藏以省每帧合成开销 */
  body::before {
    display: none;
  }

  body {
    overflow: hidden;
    background: #35291e;
  }

  /* 暖光中心 + 暗角,强化"记忆相册"的沉浸氛围 */
  .atmosphere {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 72% 68% at 50% 46%,
      rgba(255, 170, 102, 0.12) 0%,
      rgba(255, 170, 102, 0) 48%,
      rgba(53, 41, 30, 0.2) 100%
    );
  }

  /* ===== 空态 ===== */
  .empty-state {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 24px;
    color: rgba(255, 233, 205, 0.92);
    text-align: center;
  }

  .empty-state-title {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    letter-spacing: 0.12em;
  }

  .empty-state-desc {
    font-size: 0.95rem;
    color: rgba(255, 233, 205, 0.6);
  }

  .empty-state-link {
    margin-top: 12px;
    padding: 10px 26px;
    border-radius: 999px;
    font-size: 0.95rem;
    color: rgba(255, 235, 210, 0.92);
    background: rgba(232, 146, 58, 0.35);
    border: 1px solid rgba(232, 146, 58, 0.45);
    transition: background 0.2s ease;
  }

  .empty-state-link:hover {
    background: rgba(232, 146, 58, 0.55);
  }

  /* ===== 进场引导 ===== */
  .guide {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 235, 210, 0.92);
    font-family: var(--font-heading);
    font-size: 2.2rem;
    letter-spacing: 0.2em;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.55);
    pointer-events: none;
    transition: opacity 0.5s ease-out;
    animation: guide-in 0.9s ease-out backwards;
  }

  .guide.is-hidden {
    opacity: 0;
  }

  @keyframes guide-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ===== 照片说明卡(聚焦查看时的"记忆标签") ===== */
  .caption {
    position: fixed;
    left: 24px;
    bottom: 28px;
    z-index: 40;
    max-width: 340px;
    margin: 0;
    padding: 16px 20px 18px;
    background: rgba(43, 32, 24, 0.82);
    border: 1px solid rgba(232, 146, 58, 0.22);
    border-radius: 12px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);
    color: #ffe9cd;
    transition: opacity 0.35s ease-out, transform 0.35s ease-out;
  }

  .caption.is-hidden {
    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;
  }

  .caption-rule {
    width: 32px;
    height: 2px;
    margin-bottom: 12px;
    background: var(--color-primary);
  }

  .caption-title {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.4;
    color: #ffe9cd;
    margin-bottom: 8px;
  }

  .caption-meta {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    color: rgba(255, 233, 205, 0.58);
    margin-bottom: 10px;
  }

  .caption-desc {
    font-size: 0.9rem;
    line-height: 1.7;
    color: rgba(255, 233, 205, 0.8);
  }

  /* ===== 交互提示 / 返回按钮(右下角交替) ===== */
  .hint {
    position: fixed;
    right: 24px;
    bottom: 36px;
    z-index: 40;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: rgba(255, 233, 205, 0.5);
    transition: opacity 0.35s ease-out;
  }

  .hint.is-hidden {
    opacity: 0;
  }

  .back-btn {
    position: fixed;
    right: 24px;
    bottom: 28px;
    z-index: 40;
    padding: 10px 22px;
    border-radius: 999px;
    font-size: 0.95rem;
    color: rgba(255, 235, 210, 0.92);
    background: rgba(43, 32, 24, 0.68);
    border: 1px solid rgba(232, 146, 58, 0.35);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition: opacity 0.3s ease, background 0.2s ease;
  }

  .back-btn:hover {
    background: rgba(232, 146, 58, 0.35);
  }

  .back-btn:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .back-btn.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  /* ===== 加载指示 ===== */
  .loading {
    position: fixed;
    left: 50%;
    bottom: 36px;
    transform: translateX(-50%);
    z-index: 40;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: rgba(255, 233, 205, 0.55);
    transition: opacity 0.35s ease-out;
  }

  .loading.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  @media (max-width: 600px) {
    .guide {
      font-size: 1.6rem;
      letter-spacing: 0.16em;
    }

    .caption {
      left: 16px;
      bottom: 16px;
      max-width: calc(100vw - 32px);
      padding: 14px 16px 16px;
      padding-bottom: calc(14px + env(safe-area-inset-bottom, 0px));
    }

    .hint {
      right: 16px;
      bottom: 20px;
      font-size: 0.72rem;
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }

    /* 小屏下返回按钮移到右上角,避免与左下说明卡重叠 */
    .back-btn {
      right: 16px;
      top: calc(12px + env(safe-area-inset-top, 0px));
      bottom: auto;
      padding: 8px 16px;
    }

    .loading {
      bottom: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .guide,
    .caption,
    .hint,
    .back-btn,
    .loading {
      transition: none;
      animation: none;
    }
  }
</style>