---
import { ViewTransitions } from 'astro:transitions';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  theme?: 'paper' | 'night';
  immersive?: boolean;
  ogImage?: string;
}

const { title, description, theme = 'paper', immersive = false, ogImage: ogImagePath } = Astro.props;
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).toString();
const ogImage = siteUrl + (ogImagePath || 'images/team-photo.jpg');
const fullTitle = `${title} — 和音滇韵`;
const metaDescription = description || '和音滇韵｜十四日音乐支教田野纪事';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ViewTransitions />
    <meta name="description" content={metaDescription} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/jpeg" href={import.meta.env.BASE_URL + 'images/logo.jpg'} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class:list={[theme === 'night' && 'theme-night', immersive && 'layout-immersive']}>
    <a href="#main" class="skip-link">跳到主要内容</a>
    <NavBar theme={theme} />
    <main id="main"><slot /></main>
    {!immersive && <Footer theme={theme} />}
  </body>
</html>

<style is:global>
  main { min-height: calc(100vh - var(--nav-height)); min-height: calc(100dvh - var(--nav-height)); }
  .skip-link { position: fixed; left: 16px; top: -60px; z-index: 999; padding: 8px 14px; background: var(--lacquer); color: var(--paper-white); transition: top 180ms ease; }
  .skip-link:focus-visible { top: 16px; }
</style>
