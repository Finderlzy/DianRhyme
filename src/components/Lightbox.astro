<div class="lightbox-overlay" id="lightbox" aria-hidden="true">
  <button class="lightbox-close" id="lightbox-close" aria-label="关闭">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M18 6L6 18M6 6l12 12"/>
    </svg>
  </button>
  <button class="lightbox-prev" id="lightbox-prev" aria-label="上一个">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M15 18l-6-6 6-6"/>
    </svg>
  </button>
  <button class="lightbox-next" id="lightbox-next" aria-label="下一个">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="M9 18l6-6-6-6"/>
    </svg>
  </button>
  <div class="lightbox-content" id="lightbox-content">
    <img id="lightbox-img" src="" alt="" />
    <video id="lightbox-video" controls style="display:none;"></video>
  </div>
  <p class="lightbox-caption" id="lightbox-caption"></p>
</div>

<style>
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    background: rgba(20, 16, 12, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 1000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .lightbox-overlay.open {
    opacity: 1;
    pointer-events: all;
  }

  .lightbox-content {
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 90vw;
    max-height: 80vh;
  }

  .lightbox-content img,
  .lightbox-content video {
    max-width: 90vw;
    max-height: 80vh;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 16px 64px rgba(0, 0, 0, 0.4);
  }

  .lightbox-caption {
    margin-top: 20px;
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.95rem;
    text-align: center;
    max-width: 600px;
  }

  .lightbox-close {
    position: absolute;
    top: 24px;
    right: 24px;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.8);
    background: rgba(255, 255, 255, 0.08);
    transition: all 0.2s ease;
    border: none;
    cursor: pointer;
  }

  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
  }

  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.7);
    background: rgba(255, 255, 255, 0.06);
    transition: all 0.2s ease;
    border: none;
    cursor: pointer;
  }

  .lightbox-prev { left: 24px; }
  .lightbox-next { right: 24px; }

  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
  }

  @media (max-width: 600px) {
    .lightbox-prev,
    .lightbox-next {
      display: none;
    }
  }
</style>

<script>
  interface MediaItem {
    type: 'image' | 'video';
    src: string;
    caption: string;
  }

  let currentItems: MediaItem[] = [];
  let currentIndex = 0;

  function initLightbox() {
    const overlay = document.getElementById('lightbox')!;
    const img = document.getElementById('lightbox-img') as HTMLImageElement;
    const video = document.getElementById('lightbox-video') as HTMLVideoElement;
    const caption = document.getElementById('lightbox-caption')!;
    const closeBtn = document.getElementById('lightbox-close')!;
    const prevBtn = document.getElementById('lightbox-prev')!;
    const nextBtn = document.getElementById('lightbox-next')!;

    function open(items: MediaItem[], index: number) {
      currentItems = items;
      currentIndex = index;
      showCurrent();
      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      overlay.classList.remove('open');
      document.body.style.overflow = '';
      video.pause();
      video.style.display = 'none';
    }

    function showCurrent() {
      const item = currentItems[currentIndex];
      if (!item) return;

      caption.textContent = item.caption || '';

      if (item.type === 'video') {
        img.style.display = 'none';
        video.style.display = '';
        video.src = item.src;
        video.play();
      } else {
        video.style.display = 'none';
        video.pause();
        img.style.display = '';
        img.src = item.src;
        img.alt = item.caption || '';
      }
    }

    function prev() {
      currentIndex = (currentIndex - 1 + currentItems.length) % currentItems.length;
      showCurrent();
    }

    function next() {
      currentIndex = (currentIndex + 1) % currentItems.length;
      showCurrent();
    }

    closeBtn.addEventListener('click', close);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });
    prevBtn.addEventListener('click', prev);
    nextBtn.addEventListener('click', next);

    document.addEventListener('keydown', (e) => {
      if (!overlay.classList.contains('open')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') prev();
      if (e.key === 'ArrowRight') next();
    });

    // Expose globally
    (window as any).__lightbox = { open };
  }

  initLightbox();
  document.addEventListener('astro:page-load', initLightbox);
</script>
