---
export interface DiaryEntry {
  day: number;
  date: string;
  title: string;
  content: string;
}

const { entries = [] } = Astro.props as { entries: DiaryEntry[] };
---

<div class="timeline" id="diary-timeline">
  <div class="timeline-line"></div>
  {entries.map((entry, i) => (
    <div class="timeline-entry" data-index={i}>
      <div class="timeline-row">
        <span class="timeline-day">Day {entry.day}</span>
        <span class="timeline-divider"></span>
        <button class="timeline-title" data-index={i}>{entry.title}</button>
        <span class="timeline-date">{entry.date}</span>
      </div>
      <div class="timeline-content" id={`content-${i}`}>
        <div class="timeline-content-inner">
          <article class="diary-article" set:html={entry.content} />
          <button class="timeline-close" data-index={i}>
            <span>收起</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M18 15l-6-6-6 6"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  ))}
</div>

<style>
  .timeline {
    position: relative;
    max-width: 700px;
    margin: 0 auto;
  }

  .timeline-line {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(to bottom,
      var(--color-primary-light) 0%,
      var(--color-primary) 50%,
      var(--color-primary-light) 100%);
    border-radius: 1px;
  }

  .timeline-entry {
    position: relative;
    padding-left: 32px;
  }

  .timeline-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 0;
    position: relative;
    transition: transform 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  /* Dot on timeline */
  .timeline-row::before {
    content: '';
    position: absolute;
    left: -36px;
    top: 50%;
    transform: translateY(-50%);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-primary);
    border: 2px solid var(--color-bg);
    box-shadow: 0 0 0 2px var(--color-primary-light);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    z-index: 2;
  }

  .timeline-entry.active .timeline-row::before {
    transform: translateY(-50%) scale(1.4);
    box-shadow: 0 0 0 4px var(--color-primary-light);
  }

  .timeline-day {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1rem;
    color: var(--color-primary-dark);
    white-space: nowrap;
    min-width: 52px;
    flex-shrink: 0;
  }

  .timeline-divider {
    flex: 1;
    height: 1px;
    background: var(--color-border);
    min-width: 24px;
  }

  .timeline-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text);
    cursor: pointer;
    transition: color 0.2s ease;
    text-align: left;
  }

  .timeline-title:hover {
    color: var(--color-primary);
  }

  .timeline-date {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  /* Content area */
  .timeline-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .timeline-entry.active .timeline-content {
    max-height: 3000px;
  }

  .timeline-content-inner {
    padding: 0 0 32px;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.4s ease 0.15s, transform 0.4s ease 0.15s;
  }

  .timeline-entry.active .timeline-content-inner {
    opacity: 1;
    transform: translateY(0);
  }

  .diary-article {
    background: var(--color-bg-white);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    padding: 32px;
    box-shadow: var(--shadow-sm);
    line-height: 2;
    font-size: 1rem;
    color: var(--color-text-light);
  }

  .diary-article :global(p) {
    margin-bottom: 16px;
  }

  .diary-article :global(p:last-child) {
    margin-bottom: 0;
  }

  .diary-article :global(img) {
    border-radius: var(--radius-sm);
    margin: 20px 0;
  }

  .diary-article :global(blockquote) {
    border-left: 3px solid var(--color-primary-light);
    padding: 8px 16px;
    margin: 16px 0;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    background: rgba(232, 146, 58, 0.04);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .timeline-close {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 16px;
    padding: 8px 20px;
    font-size: 0.9rem;
    color: var(--color-primary-dark);
    border: 1px solid var(--color-primary-light);
    border-radius: 20px;
    transition: all 0.2s ease;
  }

  .timeline-close:hover {
    background: rgba(232, 146, 58, 0.08);
    border-color: var(--color-primary);
  }

  /* ===== Responsive ===== */
  @media (max-width: 600px) {
    .timeline-entry {
      padding-left: 24px;
    }

    .timeline-row::before {
      left: -28px;
      width: 8px;
      height: 8px;
    }

    .timeline-date {
      display: none;
    }

    .diary-article {
      padding: 20px;
    }
  }
</style>

<script>
  function initTimeline() {
    const timeline = document.getElementById('diary-timeline');
    if (!timeline) return;

    let activeIndex: number | null = null;

    const entries = timeline.querySelectorAll('.timeline-entry');
    const titleButtons = timeline.querySelectorAll('.timeline-title');
    const closeButtons = timeline.querySelectorAll('.timeline-close');

    function closeEntry(index: number) {
      const entry = entries[index] as HTMLElement;
      if (!entry || !entry.classList.contains('active')) return;

      entry.classList.remove('active');
      activeIndex = null;
    }

    function openEntry(index: number) {
      // Close previous if different
      if (activeIndex !== null && activeIndex !== index) {
        closeEntry(activeIndex);
      }

      const entry = entries[index] as HTMLElement;
      if (!entry) return;

      if (entry.classList.contains('active')) {
        closeEntry(index);
        return;
      }

      entry.classList.add('active');
      activeIndex = index;

      // Scroll to the title row
      const titleBtn = titleButtons[index] as HTMLElement;
      if (titleBtn) {
        setTimeout(() => {
          titleBtn.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 100);
      }
    }

    titleButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const idx = parseInt(btn.getAttribute('data-index') || '');
        if (!isNaN(idx)) openEntry(idx);
      });
    });

    closeButtons.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt(btn.getAttribute('data-index') || '');
        if (!isNaN(idx)) closeEntry(idx);
      });
    });
  }

  initTimeline();
  // Re-init on Astro page transitions
  document.addEventListener('astro:page-load', initTimeline);
</script>
