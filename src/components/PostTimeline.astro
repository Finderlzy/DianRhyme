---
import type { PostEntry } from '../data/posts';
import { formatPostDate } from '../data/posts';
import ResponsiveImage from './ResponsiveImage.astro';
import { getResponsiveImage } from '../lib/images';

export interface Props { entries: PostEntry[]; }
const { entries } = Astro.props;
---

{entries.length > 0 && (
  <div class="timeline-shell">
    <nav class="date-index" aria-label="纪事日期索引">
      {entries.map((entry, index) => <a href={'#' + entry.id} class:list={[index === 0 && 'is-first']}><span>{String(index + 1).padStart(2, '0')}</span>{formatPostDate(entry.date)}</a>)}
    </nav>
    <div class="post-stream">
      {entries.map((entry, index) => (
        <article id={entry.id} class:list={['post-entry', entry.variant !== 'standard' && 'post-entry--' + entry.variant]} data-post-id={entry.id}>
          <div class="post-marker"><span>{String(index + 1).padStart(2, '0')}</span><i aria-hidden="true"></i></div>
          <div class="post-side"><time datetime={entry.date}>{formatPostDate(entry.date)}</time><span>{entry.location}</span><span>{entry.phase === 'prologue' ? '序章' : '十四日主时间轴'}</span></div>
          <div class="post-content">
            {entry.cover ? <ResponsiveImage image={getResponsiveImage(entry.cover)} alt={entry.title} sizes="(max-width: 800px) calc(100vw - 68px), 700px" loading={index === 0 ? 'eager' : 'lazy'} /> : <div class="post-no-image" aria-label="暂无配图"><span>IMAGE / 待补</span></div>}
            <div class="post-copy"><p class="date-label">{entry.phase === 'prologue' ? 'PROLOGUE' : 'FIELD NOTE'} · {formatPostDate(entry.date)}</p><h3>{entry.title}</h3><p>{entry.excerpt || '这条纪事尚未补充摘要，日期与标题仍保留在时间轴中。'}</p>{entry.url ? <a class="text-link" href={entry.url} target="_blank" rel="noopener noreferrer">阅读微信原文</a> : <span class="pending-link">原文链接待提供</span>}</div>
          </div>
        </article>
      ))}
    </div>
  </div>
)}

<script>
  const items = [...document.querySelectorAll<HTMLElement>('[data-post-id]')];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.date-index a')];
  if ('IntersectionObserver' in window && items.length && links.length) {
    const observer = new IntersectionObserver((observed) => {
      observed.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const id = (entry.target as HTMLElement).dataset.postId;
        links.forEach((link) => link.classList.toggle('is-current', link.getAttribute('href') === '#' + id));
      });
    }, { rootMargin: '-18% 0px -62% 0px', threshold: 0 });
    items.forEach((item) => observer.observe(item));
  }
</script>

<style>
  .timeline-shell { position: relative; display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 48px; }
  .date-index { position: sticky; top: calc(var(--nav-height) + 28px); align-self: start; display: grid; gap: 12px; padding-top: 5px; }
  .date-index a { display: flex; align-items: baseline; gap: 8px; color: var(--mist); font-family: var(--font-mono); font-size: 0.68rem; }
  .date-index a span { color: var(--mist); font-size: 0.62rem; }
  .date-index a:hover, .date-index a.is-current { color: var(--lacquer); }
  .date-index a.is-current span { color: var(--lacquer); }
  .post-stream { position: relative; }
  .post-stream::before { content: ""; position: absolute; top: 10px; bottom: 10px; left: 7px; width: 1px; background: var(--line); }
  .post-entry { position: relative; display: grid; grid-template-columns: 32px 150px minmax(0, 1fr); gap: 20px; padding: 0 0 76px; scroll-margin-top: calc(var(--nav-height) + 32px); }
  .post-marker { position: relative; z-index: 1; padding-top: 4px; background: var(--paper); }
  .post-marker span { display: block; color: var(--lacquer); font-family: var(--font-mono); font-size: 0.68rem; }
  .post-marker i { display: block; width: 9px; height: 9px; margin: 14px 0 0 3px; border: 2px solid var(--lacquer); border-radius: 50%; background: var(--paper); }
  .post-side { display: grid; align-content: start; gap: 7px; padding-top: 4px; color: var(--mist); font-family: var(--font-mono); font-size: 0.69rem; line-height: 1.5; }
  .post-side time { color: var(--ink); }
  .post-content { min-width: 0; border-top: 1px solid var(--line); }
  .post-content > img, .post-no-image { width: 100%; margin-bottom: 22px; }
  .post-content > img { aspect-ratio: 16 / 9; object-fit: cover; }
  .post-no-image { display: grid; place-items: center; min-height: 180px; border: 1px dashed var(--line); color: var(--mist); font-family: var(--font-mono); font-size: 0.72rem; }
  .post-copy { max-width: 700px; }
  .post-copy h3 { margin: 9px 0 12px; font-size: clamp(1.5rem, 2.5vw, 2.4rem); }
  .post-copy > p:not(.date-label) { color: rgba(33, 27, 24, 0.72); line-height: 1.95; }
  .post-copy .text-link, .pending-link { margin-top: 16px; font-size: 0.84rem; }
  .pending-link { display: inline-block; color: var(--mist); }
  .post-entry--featured .post-content > img { aspect-ratio: 5 / 3; }
  @media (max-width: 800px) { .timeline-shell { grid-template-columns: 1fr; gap: 30px; } .date-index { position: static; display: flex; gap: 14px; overflow-x: auto; padding: 0 0 12px; border-bottom: 1px solid var(--line); scrollbar-width: thin; } .date-index a { flex: 0 0 auto; } .post-entry { grid-template-columns: 28px 1fr; gap: 14px; } .post-side { grid-column: 2; grid-row: 1; display: flex; flex-wrap: wrap; gap: 8px 14px; } .post-content { grid-column: 2; grid-row: 2; } .post-stream::before { left: 6px; } }
  @media (max-width: 520px) { .post-entry { padding-bottom: 54px; } .post-content > img { aspect-ratio: 4 / 3; } .post-copy h3 { font-size: 1.55rem; } }
</style>
