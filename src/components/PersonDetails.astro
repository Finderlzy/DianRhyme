---
import ResponsiveImage from './ResponsiveImage.astro';
import { getResponsiveImage } from '../lib/images';

export interface Props {
  person: { name: string; role: string; image: string; summary: string; bio: string };
}
const { person } = Astro.props;
---

<details class="person">
  <summary>
    <ResponsiveImage image={getResponsiveImage(person.image)} alt={person.name} sizes="(max-width: 520px) 50vw, 220px" loading="lazy" />
    <span class="person-text"><strong>{person.name}</strong><span>{person.role}</span><small>{person.summary}</small><i aria-hidden="true">+</i></span>
  </summary>
  <p>{person.bio}</p>
</details>
