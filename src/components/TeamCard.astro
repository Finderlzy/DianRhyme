---
export interface Props {
  name: string;
  role: string;
  bio: string;
  avatar?: string;
  expandDirection: 'right';
}

const { name, role, bio, avatar, expandDirection } = Astro.props;

const colors = ['#E8923A', '#7BA587', '#D4956B', '#6B9EB7', '#B89B7D', '#8B9E7C', '#C49A6C', '#7DA08D', '#9B7EB8'];
const colorIndex = name.length % colors.length;
const initials = name.slice(-2);
---

<div class={`team-card team-card--${expandDirection}`}>
  <div class="card-inner">
    <!-- Left: circle + name/role (always visible) -->
    <div class="card-left">
      <div class="avatar-circle" style={`background-color: ${colors[colorIndex]}`}>
        <span class="initials">{initials}</span>
      </div>
      <span class="card-name">{name}</span>
      <span class="card-role">{role}</span>
    </div>

    <!-- Middle: photo (revealed by card width expansion) -->
    <div class="card-photo">
      {avatar ? (
        <img src={avatar} alt={name} class="photo-img" />
      ) : (
        <div class="avatar-circle avatar-circle--photo" style={`background: linear-gradient(135deg, var(--color-primary-light), var(--color-accent))`}>
          <span class="initials initials--photo">{initials}</span>
        </div>
      )}
    </div>

    <!-- Right: bio (revealed by card width expansion) -->
    <div class="card-bio">
      <p>{bio}</p>
    </div>
  </div>
</div>

<style>
  /* ===== Base ===== */
  .team-card {
    background: var(--color-bg-white);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    position: relative;
    transition: box-shadow 0.35s ease, width 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    flex-shrink: 0;
    cursor: default;
    width: 155px;
    overflow: hidden;
  }

  .team-card:hover {
    box-shadow: var(--shadow-lg);
    z-index: 10;
  }

  .card-inner {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    gap: 0;
  }

  /* ===== Expand: right ===== */
  .team-card--right:hover {
    width: 500px;
  }

  .card-role {
    max-width: 70px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .team-card--right:hover .card-role {
    max-width: none;
  }

  /* Photo segment */
  .card-photo {
    flex-shrink: 0;
    max-width: 0;
    overflow: hidden;
    margin-left: 0;
    transition: max-width 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94), margin-left 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .team-card--right:hover .card-photo {
    max-width: 56px;
    margin-left: 14px;
  }

  /* Bio segment */
  .card-bio {
    flex-shrink: 0;
    max-width: 0;
    overflow: hidden;
    margin-left: 0;
    transition: max-width 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94), margin-left 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .team-card--right:hover .card-bio {
    max-width: 250px;
    margin-left: 12px;
  }

  .team-card--right .card-bio p {
    font-size: 0.9rem;
    color: var(--color-text-light);
    line-height: 1.55;
    margin: 0;
    white-space: normal;
  }

  /* ===== Left segment (always visible) ===== */
  .card-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    flex-shrink: 0;
    text-align: center;
  }

  .card-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
  }

  .card-role {
    font-size: 0.75rem;
    color: var(--color-text-light);
  }

  /* ===== Avatar circle ===== */
  .avatar-circle {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .avatar-circle--photo {
    width: 56px;
    height: 56px;
  }

  .initials {
    font-family: var(--font-heading);
    font-size: 0.8rem;
    font-weight: 700;
    color: #fff;
  }

  .initials--photo {
    font-size: 0.9rem;
  }

  .photo-img {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .team-card {
      width: 100%;
    }

    .team-card--right:hover {
      width: 100%;
    }

    .card-role {
      max-width: none;
    }
  }
</style>