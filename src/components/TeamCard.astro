---
export interface Props {
  name: string;
  role: string;
  bio: string;
  avatar?: string;
  expandDirection: 'right';
}

const { name, role, bio, avatar, expandDirection } = Astro.props;

const colors = ['#E8923A', '#D4956B', '#C49A6C', '#B89B7D', '#A98454', '#D8A86B', '#C77B3A', '#9C7A50', '#E0A96D'];
const colorIndex = name.length % colors.length;
const initials = name.slice(-2);
---

<div class={`team-card team-card--${expandDirection}`}>
  <div class="card-inner">
    <!-- Left: circle + name/role (always visible) -->
    <div class="card-left">
      <div class="avatar-circle" style={`background-color: ${colors[colorIndex]}`}>
        <span class="initials">{initials}</span>
      </div>
      <span class="card-name">{name}</span>
      <span class="card-role">{role}</span>
    </div>

    <!-- Middle: photo (revealed by card width expansion) -->
    <div class="card-photo">
      {avatar ? (
        <img src={avatar} alt={name} class="photo-img" />
      ) : (
        <div class="avatar-circle avatar-circle--photo" style={`background: linear-gradient(135deg, var(--color-primary-light), var(--color-accent))`}>
          <span class="initials initials--photo">{initials}</span>
        </div>
      )}
    </div>

    <!-- Right: bio (revealed by card width expansion) -->
    <div class="card-bio">
      <p>{bio}</p>
    </div>
  </div>
</div>

<style>
  /* ===== Base ===== */
  .team-card {
    background: var(--color-bg-white);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    position: relative;
    transition: box-shadow 0.35s ease, width 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94), height 0.35s ease;
    flex-shrink: 0;
    cursor: default;
    width: 155px;
    height: 100px;
    overflow: hidden;
  }

  .card-inner {
    display: flex;
    align-items: center;
    height: 100%;
    padding: 0 14px;
    gap: 0;
  }

  .card-role {
    max-width: 70px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .team-card--right .card-bio p {
    font-size: 0.8rem;
    color: var(--color-text-light);
    line-height: 1.55;
    margin: 0;
    white-space: normal;
  }

  /* ===== Hover-capable devices: collapsed by default, expand on hover ===== */
  @media (hover: hover) {
    .team-card:hover {
      box-shadow: var(--shadow-lg);
      z-index: 10;
      height: 140px;
    }

    .team-card--right:hover {
      width: 500px;
    }

    .team-card--right:hover .card-role {
      max-width: none;
    }

    /* Photo segment */
    .card-photo {
      flex-shrink: 0;
      max-width: 0;
      overflow: hidden;
      margin-left: 0;
      transition: max-width 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94), margin-left 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .team-card--right:hover .card-photo {
      max-width: 110px;
      margin-left: 14px;
    }

    /* Bio segment */
    .card-bio {
      flex-shrink: 0;
      max-width: 0;
      overflow: hidden;
      margin-left: 0;
      transition: max-width 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94), margin-left 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }

    .team-card--right:hover .card-bio {
      max-width: 250px;
      margin-left: 12px;
    }
  }

  /* ===== Touch devices (no hover): always expanded ===== */
  @media (hover: none) {
    .team-card {
      width: 100%;
      height: auto;
    }

    .team-card--right .card-role {
      max-width: none;
    }

    .card-photo {
      flex-shrink: 0;
      max-width: 110px;
      overflow: hidden;
      margin-left: 14px;
    }

    .card-bio {
      flex-shrink: 0;
      max-width: 250px;
      overflow: hidden;
      margin-left: 12px;
    }
  }

  /* ===== Left segment (always visible) ===== */
  .card-left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    flex-shrink: 0;
    text-align: center;
  }

  .card-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
    text-wrap: balance;
  }

  .card-role {
    font-size: 0.75rem;
    color: var(--color-text-light);
  }

  /* ===== Avatar circle ===== */
  .avatar-circle {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .avatar-circle--photo {
    width: 96px;
    height: 120px;
    border-radius: 10px;
  }

  .initials {
    font-family: var(--font-heading);
    font-size: 0.7rem;
    font-weight: 700;
    color: #fff;
  }

  .initials--photo {
    font-size: 1.3rem;
  }

  .photo-img {
    width: 96px;
    height: 120px;
    border-radius: 10px;
    object-fit: cover;
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .team-card {
      width: 100%;
    }

    .team-card--right:hover {
      width: 100%;
    }

    .card-role {
      max-width: none;
    }
  }
</style>