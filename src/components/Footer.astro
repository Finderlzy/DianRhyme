---
const base = import.meta.env.BASE_URL;
---
<footer class="footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="footer-logo">
        <span class="footer-logo-text">和音滇韵</span>
        <span class="logo-badge"><img src={base + 'images/logo.jpg'} alt="队徽" /></span>
      </span>
      <p class="footer-sub">北京科技大学 · 2026 年暑期社会实践</p>
      <p class="footer-sub">酉良和音滇韵民族团结实践团</p>
    </div>
    <div class="footer-info">
      <p>民族团结铸牢青年信仰 · 音乐支教</p>
    </div>
    <div class="footer-links">
      <a href="https://github.com/Finderlzy/DianRhyme" target="_blank" rel="noopener noreferrer">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        GitHub
      </a>
    </div>
  </div>
  <div class="footer-bottom">
    <p>&copy; 2026 和音滇韵 · 北京科技大学. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg-white);
    border-top: 1px solid var(--color-border);
    padding: 48px 24px 24px;
    margin-top: 80px;
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 48px;
    flex-wrap: wrap;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .footer-logo .logo-badge {
    width: 30px;
    height: 30px;
  }

  .footer-sub {
    margin-top: 4px;
    font-size: 0.9rem;
    color: var(--color-text-light);
  }

  .footer-info p {
    font-size: 0.9rem;
    color: var(--color-text-light);
    line-height: 1.75;
  }

  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-sm);
    font-size: 0.9rem;
    color: var(--color-text-light);
    border: 1px solid var(--color-border);
    transition: all 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--color-primary);
    border-color: var(--color-primary-light);
    background: rgba(232, 146, 58, 0.05);
  }

  .footer-bottom {
    max-width: var(--max-width);
    margin: 32px auto 0;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }
</style>
